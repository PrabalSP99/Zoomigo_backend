# ===========================================
# Application Environment
# ===========================================
NODE_ENV=production
PORT=4004

# ===========================================
# Database Configuration - MongoDB
# ===========================================
MONGODB_URI=mongodb://localhost:27017/rental_app

# ===========================================
# Database Configuration - PostgreSQL (Optional)
# ===========================================
DB_HOST=your_database_host
DB_PORT=5432
DB_NAME=your_database_name
DB_USER=your_database_user
DB_PASSWORD=your_database_password

# ===========================================
# Authentication & Security
# ===========================================
JWT_SECRET=your_super_secret_jwt_key_here_minimum_32_characters

# ===========================================
# CORS Configuration
# ===========================================
CORS_ORIGIN=https://www.badhosa.com,https://badhosa.com,http://localhost:3000

# ===========================================
# Email Service (SendGrid)
# ===========================================
SENDGRID_API_KEY=your_sendgrid_api_key_here
SENDGRID_FROM_EMAIL=your_verified_sender_email@domain.com

# ===========================================
# AWS S3 Configuration (for image uploads)
# ===========================================
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=your_aws_region
AWS_S3_BUCKET=your_s3_bucket_name
