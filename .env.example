# ===========================================
# Application Environment
# ===========================================
NODE_ENV=production
PORT=4004

# ===========================================
# Database Configuration - PostgreSQL (Primary)
# ===========================================
DB_HOST=shuttle.proxy.rlwy.net
DB_PORT=44632
DB_NAME=railway
DB_USER=postgres
DB_PASSWORD=your_new_railway_postgres_password

# ===========================================
# Authentication & Security
# ===========================================
JWT_SECRET=your_super_secret_jwt_key_here_minimum_32_characters

# ===========================================
# CORS Configuration
# ===========================================
CORS_ORIGIN=https://www.badhosa.com,https://badhosa.com,http://localhost:3000

# ===========================================
# Email Service (SendGrid)
# ===========================================
SENDGRID_API_KEY=your_sendgrid_api_key_here
SENDGRID_FROM_EMAIL=your_verified_sender_email@domain.com

# ===========================================
# AWS S3 Configuration (for image uploads)
# ===========================================
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=your_aws_region
AWS_S3_BUCKET=your_s3_bucket_name
